++		Composition comp2(orig2);
++
++		double f = this->_coefs(0, 0, 0, 0) * cR1 * cR2 * rate;
++
++		// Vacancy case
++		if (orig1.isOnAxis(Species::V) or orig2.isOnAxis(Species::V)) {
